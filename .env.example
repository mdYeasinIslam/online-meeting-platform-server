PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
MONGODB_URI=mongodb://127.0.0.1:27017/lets-talk
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
COOKIE_SAME_SITE=lax
# Set only to the known number of reverse proxies in your deployment.
TRUST_PROXY_HOPS=0
# Optional: email/password login works without Google configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google callback: http://localhost:5000/api/auth/google/callback
# Optional until requesting a meeting join token.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
